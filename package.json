{
  "name": "showreel-digital-experience",
  "version": "1.0.0",
  "private": true,
  "description": "Showreel de 30 s e tutorial vertical em HTML + GSAP, com exportação MP4 determinística.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "render": "node tools/render.mjs",
    "render:30": "node tools/render.mjs --fps 30",
    "render:preview": "node tools/render.mjs --fps 30 --scale 0.5 --out dist/preview.mp4",
    "render:tutorial": "node tools/render.mjs --page tutorial/index.html",
    "render:tutorial:preview": "node tools/render.mjs --page tutorial/index.html --fps 30 --scale 0.5 --out dist/tutorial-preview.mp4",
    "render:tutorial:whatsapp": "node tools/render.mjs --page tutorial/index.html --fps 30 --crf 21 --abr 128k --maxrate 3M --out dist/tutorial-requisicao-whatsapp.mp4",
    "render:promo": "node tools/render.mjs --page promo/index.html",
    "render:promo:whatsapp": "node tools/render.mjs --page promo/index.html --fps 30 --crf 21 --abr 128k --maxrate 3M --out dist/controleng-motion-whatsapp.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18"
  }
}
