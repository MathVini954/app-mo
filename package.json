{
  "name": "showreel-digital-experience",
  "version": "1.0.0",
  "private": true,
  "description": "Showreel de 30 s em HTML + GSAP para divulgar serviços de desenvolvimento web (sites, landing pages e sistemas).",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "render": "node tools/render.mjs",
    "render:30": "node tools/render.mjs --fps 30",
    "render:preview": "node tools/render.mjs --fps 30 --scale 0.5 --out dist/preview.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18"
  }
}
